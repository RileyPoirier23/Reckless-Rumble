## The first DriveBoss font (3 bits a row, 5 rows): for the odd character neither face has (the degree sign).
const OLD := {
	"0": [7, 5, 5, 5, 7], "1": [2, 6, 2, 2, 7], "2": [7, 1, 7, 4, 7], "3": [7, 1, 7, 1, 7], "4": [5, 5, 7, 1, 1],
