	"U": [5, 5, 5, 5, 7], "V": [5, 5, 5, 5, 2], "W": [5, 5, 7, 7, 5], "X": [5, 5, 2, 5, 5], "Y": [5, 5, 2, 2, 2],
	"Z": [7, 1, 2, 4, 7], " ": [0, 0, 0, 0, 0], ".": [0, 0, 0, 0, 2], ",": [0, 0, 0, 2, 4], ":": [0, 2, 0, 2, 0],
	"-": [0, 0, 7, 0, 0], "+": [0, 2, 7, 2, 0], "/": [1, 1, 2, 4, 4], "%": [5, 1, 2, 4, 5], "°": [2, 5, 2, 0, 0],
	"!": [2, 2, 2, 0, 2], ";": [0, 2, 0, 2, 4], "?": [7, 1, 2, 0, 2], "(": [1, 2, 2, 2, 1], ")": [4, 2, 2, 2, 4], "'": [2, 2, 0, 0, 0],
	"\"": [5, 5, 0, 0, 0], "=": [0, 7, 0, 7, 0], "<": [1, 2, 4, 2, 1], ">": [4, 2, 1, 2, 4], "#": [5, 7, 5, 7, 5],
	"[": [3, 2, 2, 2, 3], "]": [6, 2, 2, 2, 6], "_": [0, 0, 0, 0, 7], "*": [5, 2, 7, 2, 5], "&": [2, 5, 2, 5, 3], "$": [7, 6, 7, 3, 7],
}

static var _cache := {}      # [face, char] -> [width, rows of [x0, x1) runs]

## A glyph as runs of ink per row, and its width.
static func _glyph(main: bool, ch: String) -> Array:
	var key := ("M" if main else "S") + ch
	if _cache.has(key): return _cache[key]
	var face: Dictionary = MAIN if main else SMALL
	var rows: Array = []
	var w := 0
	if ch == " ":
		w = SPACE_MAIN if main else SPACE_SMALL
	elif face.has(ch):
		for r: String in face[ch]:
			w = maxi(w, r.length())
			var runs: Array = []
			var x0 := -1
			for x in r.length() + 1:
				var ink := x < r.length() and r[x] == "#"
				if ink and x0 < 0: x0 = x
				elif not ink and x0 >= 0:
					runs.append([x0, x])
					x0 = -1
			rows.append(runs)
	elif OLD.has(ch):
		# the old 3x5 glyph, set on the main face's baseline when it's a big one
		w = 3
		var pad := 2 if main else 0
		for i in pad: rows.append([])
		for bits: int in OLD[ch]:
			var runs: Array = []
			for x in 3:
				if bits & (4 >> x): runs.append([x, x + 1])
			rows.append(runs)
	else:
		return _glyph(main, "?")
	var g := [w, rows]
	_cache[key] = g
	return g

## Whether the small face (or the old font behind it) can draw this character.
static func has_glyph(ch: String) -> bool:
	return ch == " " or SMALL.has(ch) or OLD.has(ch)

## The first font's fixed-width 3x5 glyph, the same shape as small_glyph's.
static func old_glyph(ch: String) -> Array:
	var rows: Array = []
	for bits: int in OLD.get(ch, OLD["?"]):
		var runs: Array = []
		for x in 3:
			if bits & (4 >> x): runs.append([x, x + 1])
		rows.append(runs)
	return [3, rows]

## A small-face glyph for painting into an image: [width, rows of [x0, x1) runs].
static func small_glyph(ch: String) -> Array:
	return _glyph(false, ch)

static func _measure(main: bool, text: String) -> int:
	var w := 0
	var first := true
	for ch in text.to_upper():
		if not first: w += 1
		w += int(_glyph(main, ch)[0])
		first = false
	return w

## The main face's pixel size for text drawn at `scale` (0 = it's a small-face line).
static func _main_k(text: String, scale: int) -> int:
	if scale < 2: return 0
	var k := maxi(1, roundi(scale * 5.0 / 7.0))
	var old_w := text.length() * 4 * scale - scale
	while k > 1 and _measure(true, text) * k > old_w: k -= 1
	return k

static func width(text: String, scale := 1) -> int:
	var k := _main_k(text, scale)
	if k > 0: return _measure(true, text) * k
	return _measure(false, text) * scale

## Draws `text` on `ci` (a CanvasItem inside its _draw) with its top-left at `pos`.
static func draw(ci: CanvasItem, pos: Vector2, text: String, color: Color, scale := 1, shadow := Color(0, 0, 0, 0)) -> void:
	if shadow.a > 0.0:
		draw(ci, pos + Vector2(scale, scale), text, shadow, scale)
	var k := _main_k(text, scale)
	var main := k > 0
	var px := k if main else scale
	var x := pos.x
	var y := pos.y
	if main: y += floorf((5.0 * scale - 7.0 * k) / 2.0)        # centred where the old 5-row text sat
	for ch in text.to_upper():
		var g := _glyph(main, ch)
		var rows: Array = g[1]
		for ry in rows.size():
			for run: Array in rows[ry]:
				ci.draw_rect(Rect2(x + int(run[0]) * px, y + ry * px, (int(run[1]) - int(run[0])) * px, px), color)
		x += (int(g[0]) + 1) * px

static func draw_centered(ci: CanvasItem, center_x: float, y: float, text: String, color: Color, scale := 1, shadow := Color(0, 0, 0, 0)) -> void:
	draw(ci, Vector2(roundf(center_x - width(text, scale) / 2.0), y), text, color, scale, shadow)
